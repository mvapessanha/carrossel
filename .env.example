# Google AI Studio (Gemini "Nano Banana") - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq Cloud (planner de texto, divide o conteudo entre os slides) - https://console.groq.com/keys
GROQ_API_KEY=

# Together AI (fallback FLUX schnell) - NAO recomendado por enquanto: desde 2025
# exige cartao com cobranca minima de US$5 so pra criar a conta. Deixe em branco.
TOGETHER_API_KEY=

# Hugging Face (FLUX Kontext, segue 1 imagem de referencia) - gratis, sem cartao.
# Crie o token em https://huggingface.co/settings/tokens (tipo "Read" basta).
HF_TOKEN=

# Pollinations "flux" (fallback final) nao exige chave. Ja o "kontext" (referencia
# estetica) exige cadastro gratuito no tier "Seed" em https://enter.pollinations.ai
# -- cole o token aqui pra habilitar. Sem isso, kontext falha e cai pro proximo.
# POLLINATIONS_TOKEN=

# Supabase -- banco Postgres (substitui o SQLite local) + storage de imagens
# (substitui o disco local) -- obrigatorios pra rodar em hospedagem com disco
# efemero (Render free tier apaga tudo a cada ~15min de inatividade).
# Crie um projeto gratis em https://supabase.com, depois:
# SUPABASE_URL: Settings -> General (ou botao "Connect" no topo) -> Project URL
# SUPABASE_SERVICE_KEY: Settings -> API Keys -> Secret keys (revelar com o olho)
# DATABASE_URL: botao "Connect" -> Connection string -> Transaction pooler
#   (porta 6543, IPv4 -- a conexao direta/5432 e' so IPv6 e nao funciona no Render)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
# SUPABASE_BUCKET=carrossel-images  # opcional, esse e' o padrao
